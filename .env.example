# Copy to .env.local and fill machine-local values.  Do not commit .env.local.
# CT=/path/to/commandline-tools-linux-.../command-line-tools
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# BUILD_ROOT=$PWD/build
# TARGET=192.168.102.58:37103

# Debug signing material (required by scripts/build-debug-app.sh).
# Paths default to refs/debug/...; the passwords can also live in
# refs/debug/CREDENTIALS.txt as store_password= / key_password= (mode 0600).
# DEBUG_KEYSTORE=/path/to/demo.p12
# DEBUG_KEYSTORE_PWD=...
# DEBUG_KEY_ALIAS=demo_key
# DEBUG_KEY_PWD=...
# DEBUG_APP_CERT=$PWD/refs/debug/cert1.cer
# DEBUG_PROFILE=$PWD/refs/debug/emacs-hmos3Debug.p7b

# Release signing material for scripts/build-release-app.sh.  The RELEASE_*
# defaults point at refs/release/ and read the passwords from
# refs/release/CREDENTIALS.txt; override only when the material lives elsewhere.
# RELEASE_KEYSTORE=...
# RELEASE_KEYSTORE_PWD=...
# RELEASE_KEY_ALIAS=emacs_release
# RELEASE_KEY_PWD=...
# RELEASE_APP_CERT=...
# RELEASE_PROFILE=...
