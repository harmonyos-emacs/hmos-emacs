From 66eaec1baa5d1b157130cb2687b029144ab12b4e Mon Sep 17 00:00:00 2001
From: emacs-hmos <emacs-hmos@localhost>
Date: Tue, 27 Oct 2026 15:28:59 +0800
Subject: [PATCH 2/3] Use the real HOME on HarmonyOS when the Lisp environment
 is not ready

The HarmonyOS port starts Emacs from a shared library inside an
application process; when a pdump is loaded, get_homedir can run
before process-environment has been populated, so fall back to the C
library's HOME.
---
 src/fileio.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/fileio.c b/src/fileio.c
index e1b46c52854..54eb8cade41 100644
--- a/src/fileio.c
+++ b/src/fileio.c
@@ -1950,6 +1950,15 @@ get_homedir (void)
 {
   char const *home = egetenv ("HOME");
 
+#ifdef HAVE_OHOS
+  /* The HarmonyOS application starts Emacs with HOME set, but the
+     Lisp environment list may not have been populated when this is
+     first called (in particular when a pdump is in use).  Fall back to
+     the real process environment.  */
+  if (!home)
+    home = getenv ("HOME");
+#endif
+
 #ifdef WINDOWSNT
   /* getpw* functions return UTF-8 encoded file names, whereas egetenv
      returns strings in locale encoding, so we need to convert for
