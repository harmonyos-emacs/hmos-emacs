From 4b1ceaa7b03e292454fb6f878718c3d362ab162c Mon Sep 17 00:00:00 2001
From: emacs-hmos <emacs-hmos@localhost>
Date: Tue, 27 Oct 2026 15:42:16 +0800
Subject: [PATCH 3/3] Expand ~USER to the process home on HarmonyOS

HarmonyOS applications have no /etc/passwd entry, so the login name
derived from the uid cannot be looked up and startup reports that the
user has no home directory.  Fall back to get_homedir() for such
names.
---
 src/fileio.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/fileio.c b/src/fileio.c
index 54eb8cade41..3eb6ca57e9b 100644
--- a/src/fileio.c
+++ b/src/fileio.c
@@ -1426,6 +1426,13 @@ the root directory.  */)
       else			/* ~user/filename */
 	{
 	  char *nmhome = user_homedir (nm + 1);
+#ifdef HAVE_OHOS
+	  /* HarmonyOS applications have no /etc/passwd entry, so the
+	     login name (derived from the uid) cannot be looked up.
+	     Expand such ~USER names to the process' home directory.  */
+	  if (!nmhome)
+	    nmhome = (char *) get_homedir ();
+#endif
 	  if (nmhome)
 	    {
 	      ptrdiff_t nmhomelen = strlen (nmhome);
-- 
