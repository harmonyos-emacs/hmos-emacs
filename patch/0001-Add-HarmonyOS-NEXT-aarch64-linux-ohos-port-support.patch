From 1d8e45fa14d3727b1ca2a2d1d76e3389648c27ee Mon Sep 17 00:00:00 2001
From: emacs-hmos <emacs-hmos@localhost>
Date: Tue, 27 Oct 2026 15:02:31 +0800
Subject: [PATCH 1/3] Add HarmonyOS NEXT (aarch64-linux-ohos) port support

- configure.ac: detect *-ohos* hosts and define HAVE_OHOS.
- sysdep.c: use the local posix_close emulation on OHOS (its unistd.h
  declares POSIX_CLOSE_RESTART but the C library lacks posix_close),
  and print the fault address/PC on SIGSEGV for debugging.
- emacs.c: on OHOS also call set_initial_environment when dumping, so
  the device-generated dump can find its Lisp via EMACSLOADPATH, and
  honour --dump-file (as the Android port does) so the application can
  point Emacs at the dump it produced on the device.
- lread.c: do not ignore EMACSLOADPATH when dumping on OHOS.
---
 configure.ac | 10 ++++++++++
 src/emacs.c  | 10 ++++++++--
 src/lread.c  |  8 +++++++-
 src/sysdep.c | 17 ++++++++++++++++-
 4 files changed, 41 insertions(+), 4 deletions(-)

diff --git a/configure.ac b/configure.ac
index 98896f7795b..5d12bda1768 100644
--- a/configure.ac
+++ b/configure.ac
@@ -175,6 +175,16 @@ fi
 AC_CANONICAL_HOST
 AC_CANONICAL_BUILD
 
+# Detect HarmonyOS NEXT, whose C library is musl based but whose
+# headers advertise a few POSIX.1-2024 facilities that the library
+# does not actually provide.
+case $host in
+  *-ohos*)
+    AC_DEFINE([HAVE_OHOS], [1],
+      [Define to 1 if compiling for HarmonyOS NEXT.])
+    ;;
+esac
+
 AS_IF([test "$XCONFIGURE" = "android"],[
   # Initialize the Android NDK build system.  Make sure to use the
   # passed through NDK path.
diff --git a/src/emacs.c b/src/emacs.c
index 07343663b4f..5cbb4f4166b 100644
--- a/src/emacs.c
+++ b/src/emacs.c
@@ -937,7 +937,7 @@ dump_error_to_string (int result)
 static char *
 load_pdump (int argc, char **argv, char *dump_file)
 {
-#if defined HAVE_ANDROID && !defined ANDROID_STUBIFY
+#if (defined HAVE_ANDROID && !defined ANDROID_STUBIFY) || defined HAVE_OHOS
   int skip_args = 0, result;
 
   while (skip_args < argc - 1)
@@ -2161,9 +2161,15 @@ Using an Emacs configured with --with-x-toolkit=lucid does not have this problem
     syms_of_callproc ();
   /* egetenv is a pretty low-level facility, which may get called in
      many circumstances; it seems flimsy to put off initializing it
-     until calling init_callproc.  Do not do it when dumping.  */
+     until calling init_callproc.  Do not do it when dumping, except on
+     HarmonyOS, where the dump is produced on the target device and must
+     therefore use that device's environment to find its Lisp files.  */
+#ifdef HAVE_OHOS
+  set_initial_environment ();
+#else
   if (!will_dump_p ())
     set_initial_environment ();
+#endif
 
   /* Has to run after the environment is set up. */
   init_atimer ();
diff --git a/src/lread.c b/src/lread.c
index 72791bdc80f..24c3ee20689 100644
--- a/src/lread.c
+++ b/src/lread.c
@@ -5422,8 +5422,14 @@ init_lread (void)
 {
   /* First, set Vload_path.  */
 
-  /* Ignore EMACSLOADPATH when dumping.  */
+  /* Ignore EMACSLOADPATH when dumping, except on HarmonyOS, where
+     the dump is generated on the device itself and must therefore
+     record the device's load path.  */
+#ifdef HAVE_OHOS
+  bool use_loadpath = true;
+#else
   bool use_loadpath = !will_dump_p ();
+#endif
 
   if (use_loadpath && egetenv ("EMACSLOADPATH"))
     {
diff --git a/src/sysdep.c b/src/sysdep.c
index 42f71b72fae..7a98210901d 100644
--- a/src/sysdep.c
+++ b/src/sysdep.c
@@ -20,6 +20,7 @@ along with GNU Emacs.  If not, see <https://www.gnu.org/licenses/>.  */
 #include <config.h>
 
 #include <execinfo.h>
+#include <ucontext.h>
 #include "sysstdio.h"
 #ifdef HAVE_PWD_H
 #include <pwd.h>
@@ -1954,6 +1955,19 @@ static struct sigaction old_sigsegv_handler;
 static void
 handle_sigsegv (int sig, siginfo_t *siginfo, void *arg)
 {
+#ifdef HAVE_OHOS
+  /* HarmonyOS has no equivalent of a tombstone, so print the faulting
+     address and program counter for debugging.  */
+  {
+    ucontext_t *uc = (ucontext_t *) arg;
+    fprintf (stderr, "\n[SIGSEGV addr=%p pc=%p sp=%p]\n",
+	     siginfo ? siginfo->si_addr : NULL,
+	     uc ? (void *) uc->uc_mcontext.pc : NULL,
+	     uc ? (void *) uc->uc_mcontext.sp : NULL);
+    fflush (stderr);
+  }
+#endif
+
   /* Hard GC error may lead to stack overflow caused by
      too nested calls to mark_object.  No way to survive.  */
   bool fatal = gc_in_progress;
@@ -2616,7 +2630,8 @@ emacs_pipe (int fd[2])
 
 #if !(defined HAVE_ANDROID && !defined ANDROID_STUBIFY)
 
-#ifndef POSIX_CLOSE_RESTART
+#if !defined POSIX_CLOSE_RESTART || defined HAVE_OHOS
+# undef POSIX_CLOSE_RESTART
 # define POSIX_CLOSE_RESTART 1
 static int
 posix_close (int fd, int flag)
-- 
